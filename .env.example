# Copy this file to .env.local for local development. Never commit real values.
# Placeholders only. Staging and production set their own values on the host.

# Address of the Gradea API. Locally this is gradea-backend's `npm run dev` (PORT=4000 there).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Cloudflare Turnstile site key (public, from the Cloudflare dashboard). Leave empty locally:
# the waitlist form then skips the bot check and sends no bot_token. Set it on staging and
# production, where the backend has BOT_CHECK_ENABLED=true.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# PostHog project API key (public, starts with phc_). Empty means analytics is fully off.
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog address. EU cloud by default; change only if the project lives elsewhere.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Next.js telemetry is always off: every npm script runs Next through scripts/next.mjs, which
# sets NEXT_TELEMETRY_DISABLED=1. Nothing to set here.
